# Template only. ADC locally; dedicated service identity on Cloud Run. No API keys.
GOOGLE_CLOUD_PROJECT=replace-with-confirmed-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
# Exact origins for direct browser access; same-origin Firebase rewrite needs no CORS.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
PORT=8080

# Local stays compatible. Cloud Run requires firebase authentication.
AUTH_MODE=local
QUOTA_DATABASE=sourcelens
DAILY_USER_LIMIT=5
DAILY_GLOBAL_LIMIT=50
REQUIRE_VERIFIED_EMAIL=true
